# cp env.sh.example env.sh 후 값 수정 (env.sh는 git에 올라가지 않음 — .gitignore의 .env* 와 별개로 아래 규칙 참고)
export NCP_REGION=KR
export NCP_ZONE=KR-2
export PREFIX=albalaw
export VPC_CIDR=10.0.0.0/16
export SUBNET_CIDR=10.0.1.0/24
export LOGIN_KEY_NAME=${PREFIX}-key
# 02-server.sh 실행 전 01 스크립트 출력에서 골라 채우기
export SERVER_IMAGE_NO=
export SERVER_SPEC_CODE=
export OBJECT_STORAGE_BUCKET=${PREFIX}-uploads
