# cp env.sh.example env.sh 후 수정 (env.sh, .state/는 git에 올라가지 않음)
export NCP_REGION=KR
export NCP_ZONE=KR-2
export PREFIX=albalaw
# 기존 VPC를 쓰면 지정, 비우면 새로 생성
export VPC_NO=
export SUBNET_NO=
export VPC_CIDR=10.0.0.0/16
export SUBNET_CIDR=10.0.1.0/24
export LOGIN_KEY_NAME=
export SERVER_IMAGE_NO=23214590      # Ubuntu 22.04 (KVM)
export SERVER_SPEC_CODE=c2-g3a       # 2vCPU / 4GB
export OBJECT_STORAGE_BUCKET=${PREFIX}-uploads
export NCR_NAME=${PREFIX}
export NCR_BUCKET=${PREFIX}-ncr
