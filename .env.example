# 이 파일을 backend/.env 로 복사해서 값을 채우세요. (.env는 git에 올라가지 않습니다)
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=sqlite:///./local.db
# DATABASE_URL=mysql+pymysql://user:pass@<cdb-host>:3306/albalaw

# NCP 공통 (Object Storage)
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
OBJECT_STORAGE_BUCKET=

# CLOVA OCR (도메인별 Invoke URL / Secret)
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# CLOVA Speech 장문 인식
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=

# CLOVA Studio
CLOVA_STUDIO_API_KEY=

# CLOVA Chatbot
CLOVA_CHATBOT_INVOKE_URL=
CLOVA_CHATBOT_SECRET=

# Papago / CSR / CLOVA Voice (AI·NAVER API Application 키)
NCP_APIGW_CLIENT_ID=
NCP_APIGW_CLIENT_SECRET=

# 공공데이터포털 서비스키 (Decoding 키)
DATA_GO_KR_SERVICE_KEY=
