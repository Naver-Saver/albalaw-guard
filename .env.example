# 이 파일을 backend/.env 로 복사해서 값을 채우세요. (.env는 git에 올라가지 않습니다)
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:5173"]

# NCP 공통 (Object Storage)
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
OBJECT_STORAGE_REGION=kr-standard
OBJECT_STORAGE_BUCKET=albalaw-uploads
STORAGE_BACKEND=auto
UPLOAD_PREFIX=uploads/
# law-data/*.json Object Storage 재조회 주기(초)
LAW_DATA_CACHE_SEC=600
LAW_DATA_KEY=law-data/manyask-worker.json

# CLOVA OCR — 도메인 > API Gateway 연동의 APIGW Invoke URL / Secret Key
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# CLOVA Speech 장문 인식 — 도메인(인식 대상·결과 경로 = albalaw-uploads)
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
CLOVA_SPEECH_DATA_KEY_PREFIX=
CLOVA_SPEECH_RESULT_PREFIX=
RECORDING_RESULT_WAIT_SEC=60

# CLOVA Studio — API 키(nv-…), Request ID(플레이그라운드 > 코드 보기)
CLOVA_STUDIO_API_KEY=
CLOVA_STUDIO_REQUEST_ID=
CLOVA_STUDIO_MODEL=HCX-005

# CLOVA Chatbot — 도메인 > API Gateway 연동
CLOVA_CHATBOT_INVOKE_URL=
CLOVA_CHATBOT_SECRET=

# AI·NAVER API > Application (CLOVA Speech Recognition + CLOVA Voice 선택)
AINAVER_CLIENT_ID=
AINAVER_CLIENT_SECRET=

# Papago Translation > Application (Text Translation 선택) — 위와 다른 별도 키
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=

# 공공데이터포털 백문백답(15159736) 일반 인증키 — 코드(requests)에는 Decoding 키
DATA_GO_KR_SERVICE_KEY=

# 국가법령정보센터 Open API (open.law.go.kr) — 신청한 OC 아이디
LAW_GO_KR_OC=
